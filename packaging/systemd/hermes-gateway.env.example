# Copy to ~/.config/hermes-gateway/env and edit. Mode 0600: it holds a key.
#
# Nothing in this file belongs in version control. It is one machine's
# configuration, and the repository deliberately contains no addresses, no
# paths and no credentials of its own.

# The model to serve. An absolute path.
HERMES_MODEL=/absolute/path/to/model.gguf

# How to serve it. --host takes an address or a name and may be repeated, so a
# machine holding both a LAN address and an overlay address can serve on each:
#
#   HERMES_SERVE_ARGS=--host 127.0.0.1
#   HERMES_SERVE_ARGS=--host my-machine-name
#   HERMES_SERVE_ARGS=--host my-lan-name --host my-mesh-name
#
# The default port is 11434; pass --port to change it.
#
# Binding by name is usually the better choice: an overlay network can reissue
# an address, and the name is looked up again at every start.
HERMES_SERVE_ARGS=--host 127.0.0.1

# A single static key, honoured alongside any named keys the gateway keeps in
# its own config/api-keys.json. As soon as a bind is reachable from another
# machine the gateway refuses to start without at least one key of either kind.
# Leave this empty and run `hermes key create` instead, or paste a static key
# here (generate one with: openssl rand -hex 24).
HERMES_API_KEY=

# Optional: log filter, e.g. hermes=debug
# HERMES_LOG=hermes=info
