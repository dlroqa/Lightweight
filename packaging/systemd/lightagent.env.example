# Copy to ~/.config/lightagent/env and edit. Mode 0600: it may hold a key.
#
# Nothing in this file belongs in version control. It is one machine's
# configuration, and the repository deliberately contains no addresses, no paths
# and no credentials of its own.

# How to serve the Lightagent API. --host takes an address or a name and may be
# repeated; --port defaults to 8735. A loopback bind (127.0.0.1, localhost, ::1)
# is open and needs no key. Any other bind is reachable from another machine and
# REQUIRES a key: add `--key-env LIGHTAGENT_API_KEY` and set the key below.
#
#   LIGHTAGENT_SERVE_ARGS=--host 127.0.0.1
#   LIGHTAGENT_SERVE_ARGS=--host my-lan-name --key-env LIGHTAGENT_API_KEY
#   LIGHTAGENT_SERVE_ARGS=--host 0.0.0.0 --port 8735 --key-env LIGHTAGENT_API_KEY
#
# To also serve the built WebUI panel, add `--web-root /path/to/frontend/dist`.
LIGHTAGENT_SERVE_ARGS=--host 127.0.0.1

# The API key, read only when LIGHTAGENT_SERVE_ARGS names it via --key-env. Leave
# empty for a loopback-only bind. Generate one with: openssl rand -hex 24
# Do NOT add --key-env while this is empty: an empty key is still a key, and
# would lock the API behind a value nobody can send.
LIGHTAGENT_API_KEY=

# Optional: use a non-default isolated home (default: ~/.lightagent). An absolute
# path — systemd does not expand ~ or %h inside an environment file value.
# LIGHTAGENT_HOME=/absolute/path/to/.lightagent
