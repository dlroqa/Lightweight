# Copy to .env. Keep this file private: it grants Open WebUI access to the
# Lightweight gateway and its terminal service.

# Configure every remote Lightweight route that Open WebUI may use. The
# semicolon-separated URL and key lists are index-aligned: URL 0 uses key 0,
# URL 1 uses key 1, and so on. Every URL must use HTTPS and end in /v1. Use a
# dedicated least-privilege key for each route; never use a management key.
LIGHTWEIGHT_OPENAI_API_BASE_URLS=https://lightweight-fast.example/v1;https://lightweight-reasoning.example/v1;https://lightweight-context.example/v1
LIGHTWEIGHT_OPENAI_API_KEYS=replace-with-fast-route-key;replace-with-reasoning-route-key;replace-with-context-route-key

# JSON keyed by the same zero-based route index. prefix_id makes duplicate
# upstream model IDs unambiguous in Open WebUI: for example fast.llama-3.1.
LIGHTWEIGHT_OPENAI_API_CONFIGS={"0":{"enable":true,"prefix_id":"fast","connection_type":"external"},"1":{"enable":true,"prefix_id":"reasoning","connection_type":"external"},"2":{"enable":true,"prefix_id":"context","connection_type":"external"}}

# The workbench UI binds to loopback by default. A remote user should reach it
# through an authenticated HTTPS reverse proxy or private VPN.
WORKBENCH_BIND=127.0.0.1
WORKBENCH_PORT=3000

# Generate distinct values, for example:
#   openssl rand -hex 32
SEARXNG_SECRET=replace-with-a-random-secret

# Disabled by default; starts only with `docker compose --profile terminal up`.
# Bare-metal terminal execution is only appropriate for one trusted local admin.
OPEN_TERMINAL_API_KEY=replace-with-a-random-secret

# Optional Jev advice for the selectable "Lightweight Auto" model in Open
# WebUI. It is off by default. When enabled, the pipe sends only the latest
# user prompt (truncated below) and coarse feature flags to TypeSafe. It never
# sends chat history, user/account identifiers, document contents, retrieved
# chunks, or gateway keys. Leave TYPESAFE_API_KEY empty to keep the local,
# deterministic fallback even when the pipe is selected.
JEV_ENABLED=false
JEV_API_URL=https://api.typesafe.ai/v1/systemone
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_TIMEOUT_SECONDS=1.5
JEV_MIN_CONFIDENCE=0.70
JEV_MAX_PROMPT_CHARS=1200

# The Pipe only selects these prefixed Open WebUI IDs. The default must be
# listed here. An upstream model named llama-3.1 behind route fast is fast.llama-3.1.
LIGHTWEIGHT_AUTO_DEFAULT_MODEL=fast.replace-with-your-default-model-id
LIGHTWEIGHT_AUTO_ALLOWED_MODELS=fast.replace-with-your-default-model-id,reasoning.replace-with-your-reasoning-model-id,context.replace-with-your-context-model-id

# Optional JSON map from Jev's five advisories to allowlisted prefixed model
# IDs. Omitted routes fall back to LIGHTWEIGHT_AUTO_DEFAULT_MODEL.
# JEV_ROUTE_MODELS={"direct":"fast.fast-model","documents":"context.context-model","web":"context.context-model","documents_and_web":"context.context-model","terminal":"reasoning.code-model"}
JEV_ROUTE_MODELS={}

# Pin these tags after validating an upgrade in a staging deployment.
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:main
QDRANT_IMAGE=qdrant/qdrant:latest
TIKA_IMAGE=apache/tika:latest-full
SEARXNG_IMAGE=searxng/searxng:latest
INFINITY_IMAGE=michaelf34/infinity:latest-cpu
OPEN_TERMINAL_IMAGE=ghcr.io/open-webui/open-terminal:latest
