{
  "name": "hermes-desktop",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "The Hermes desktop shell: a window onto a gateway, and a supervisor for one.",
  "main": "dist/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test --test-timeout=120000 src/*.test.ts",
    "build": "tsc && tsc -p tsconfig.preload.json && node scripts-build.mjs && npm run test",
    "start": "npm run build && electron .",
    "package": "npm run build && node scripts-stage.mjs && electron-builder"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.7",
    "typescript": "^5.7.2"
  },
  "build": {
    "appId": "ai.hermes.cpu-inference-gateway",
    "toolsets": {
      "appimage": "1.0.3"
    },
    "productName": "Hermes",
    "icon": "build/icons",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../frontend/dist",
        "to": "panel"
      },
      {
        "from": "staging/bin",
        "to": "bin"
      }
    ],
    "linux": {
      "target": [
        "flatpak",
        "AppImage"
      ],
      "executableArgs": [],
      "category": "Development",
      "syncDesktopName": true,
      "synopsis": "Local CPU inference gateway"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "gatekeeperAssess": false,
      "notarize": false
    },
    "flatpak": {
      "runtimeVersion": "24.08",
      "baseVersion": "24.08",
      "license": "../../LICENSE",
      "finishArgs": [
        "--socket=wayland",
        "--socket=fallback-x11",
        "--share=ipc",
        "--device=dri",
        "--share=network",
        "--filesystem=xdg-download",
        "--talk-name=org.kde.StatusNotifierWatcher"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "shortcutName": "Hermes"
    },
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "publish": null
  },
  "desktopName": "hermes.desktop",
  "author": "Hermes"
}
