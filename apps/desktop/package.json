{
  "name": "hermes-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The Hermes desktop shell: a window onto a gateway, and a supervisor for one.",
  "main": "dist/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test --test-timeout=120000 src/*.test.ts",
    "build": "tsc && tsc -p tsconfig.preload.json && node scripts-build.mjs && npm run test",
    "start": "npm run build && electron .",
    "package": "npm run build && electron-builder"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.2"
  },
  "build": {
    "appId": "ai.hermes.cpu-inference-gateway",
    "productName": "Hermes",
    "icon": "build/icons",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../frontend/dist",
        "to": "panel"
      },
      {
        "from": "../../target/release/hermes",
        "to": "bin/hermes"
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "syncDesktopName": true,
      "synopsis": "Local CPU inference gateway"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "directories": {
      "output": "release"
    }
  },
  "desktopName": "hermes.desktop",
  "author": "Hermes"
}
